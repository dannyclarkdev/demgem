# demgem in Docker. Copy this to .env.docker and fill in APP_KEY.
#
#   docker compose run --rm --no-deps app php artisan key:generate --show
#
# Keep this file out of git: .env.docker is ignored, .env.docker.example is not.

APP_NAME=demgem
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Change the password here and in compose.yaml together before anyone else can
# reach this instance.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=demgem
DB_USERNAME=demgem
DB_PASSWORD=demgem_change_me

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# The sessions table lives in Postgres, so a Redis restart keeps everyone signed in.
SESSION_DRIVER=database
SESSION_LIFETIME=120

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Entity images and campaign covers. Use s3 with the AWS_* keys for object storage.
MEDIA_DISK=public
FILESYSTEM_DISK=local

SCOUT_DRIVER=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="demgem@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set to false to run migrations by hand:
#   docker compose exec app php artisan migrate --force
AUTO_MIGRATE=true

# The live table. Any three strings work; make them with "openssl rand -hex 16".
# Set BROADCAST_CONNECTION=null to run the stack without the reverb service.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# The address a browser reaches, which is your own host and published port, not
# the container name. The server binds separately, below.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Where the app and the queue worker publish to, which is not where a browser
# connects: inside the compose network the server is "reverb" on port 8080, and
# "localhost" would make the worker call itself. Leave these alone.
REVERB_PUBLISH_HOST=reverb
REVERB_PUBLISH_PORT=8080
REVERB_PUBLISH_SCHEME=http
